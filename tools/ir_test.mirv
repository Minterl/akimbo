language Hedral;

(* this is a comment *)

type Address;
type Index;
type Scalar;
type Coordinate;
type Domain;
type AffineTransform;
type AffineAddressOperator;
type ScalarConsPair;
type ScalarExpression;

type LoopBody = Lambda ((), Coordinate);

operator IntroduceDomain (host: << AK_Polyhedron >>) -> Domain;
operator IntroduceAffineTransform (host: << AK_AffineTransform >>) -> AffineTransform;
operator IntroduceAffineAddressOperator (host: << AK_AffineTransform >>) -> AffineAddressOperator;
operator IntroduceScalarExpression (host: << AK_ScalarExpression >>) -> ScalarExpression;

operator ApplyAffineTransform (coord: Coordinate, atran: AffineTransform) -> Coordinate;
operator ApplyAffineAddressOperator (addr_op: AffineAddressOperator, coord: Coordinate) -> Address;
operator ApplyScalarExpression (scalar_expr: ScalarExpression, cons_pair: ScalarConsPair) -> Scalar;
operator Access (addr: Address) -> Scalar;
operator MakeScalarConsPair (x0: Scalar, x1: Scalar) -> ScalarConsPair;

operator YieldAssign (addr: Address, val: Scalar);
operator YieldAccumulate (addr: Address, val: Scalar);

operator For (iteration_domain: Domain, loop_body: LoopBody);

combinator BinaryReduction (
    iteration_domain: << AK_Polyhedron >>,

    y_atran:  << AK_AffineTransform >>,
    x0_atran: << AK_AffineTransform >>,
    x1_atran: << AK_AffineTransform >>,

    y_address_op:  << AK_AffineTransform >>,
    x0_address_op: << AK_AffineTransform >>,
    x1_address_op: << AK_AffineTransform >>,

    scalar_expression: << AK_ScalarExpression >>,
) {
    %D: Domain = IntroduceDomain(iteration_domain);

    %y_transform:  AffineTransform = IntroduceAffineTransform(y_atran);
    %x0_transform: AffineTransform = IntroduceAffineTransform(x0_atran);
    %x1_transform: AffineTransform = IntroduceAffineTransform(x1_atran);

    %y_addr_op:  AffineAddressOperator = IntroduceAffineAddressOperator(y_address_op);
    %x0_addr_op: AffineAddressOperator = IntroduceAffineAddressOperator(x0_address_op);
    %x1_addr_op: AffineAddressOperator = IntroduceAffineAddressOperator(x1_address_op);

    %scalar_expr: ScalarExpression = IntroduceScalarExpression(scalar_expression);

    %loop_body: LoopBody = lambda (%induction_vector : Coordinate) {
        %y_coord:  Coordinate = ApplyAffineTransform(%induction_vector, %y_transform);
        %y_addr:   Address    = ApplyAffineAddressOperator(%y_addr_op, %y_coord);

        %x0_coord: Coordinate = ApplyAffineTransform(%induction_vector, %x0_transform);
        %x0_addr:  Address    = ApplyAffineAddressOperator(%x0_addr_op, %x0_coord);

        %x1_coord: Coordinate = ApplyAffineTransform(%induction_vector, %x1_transform);
        %x1_addr:  Address    = ApplyAffineAddressOperator(%x1_addr_op, %x1_coord);

        %x0: Scalar = Access(%x0_addr);
        %x1: Scalar = Access(%x1_addr);
        %cons_pair: ScalarConsPair = MakeScalarConsPair(%x0, %x1);
        %y: Scalar = ApplyScalarExpression(%scalar_expr, %cons_pair);

        YieldAccumulate(%y_addr, %y);
    };

    For(%D, %loop_body);
}
